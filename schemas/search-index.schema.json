{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 10,
  "items": {
    "type": "object",
    "required": ["type", "name", "href", "aliases"],
    "properties": {
      "type": { "type": "string" },
      "name": { "type": "string", "minLength": 1 },
      "href": { "type": "string", "minLength": 1 },
      "aliases": { "type": "array", "items": { "type": "string" } }
    }
  }
}
