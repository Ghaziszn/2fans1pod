# Copy this file to .env and fill in the values.
# .env is gitignored. Never commit a real key.

# Free key from https://collegefootballdata.com
CFBD_API_KEY=

# Public form key from https://web3forms.com
# This one is visible in the built site. That is how static forms work.
# The College Football Data key above must never be public.
WEB3FORMS_ACCESS_KEY=
